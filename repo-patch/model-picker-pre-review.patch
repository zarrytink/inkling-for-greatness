@@ -0,0 +1,74 @@
+import type { ComponentProps } from "react";
+import type { PointerEvent as ReactPointerEvent } from "react";
+import { cn } from "~/lib/utils";
+
+interface ModelPickerResizeHandlers {
+  ref: (node: HTMLElement | null) => (() => void) | undefined;
+  onPointerDown: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerMove: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerUp: (event: ReactPointerEvent<HTMLElement>) => void;
+  onPointerCancel: (event: ReactPointerEvent<HTMLElement>) => void;
+  onLostPointerCapture: (event: ReactPointerEvent<HTMLElement>) => void;
+}
+
+interface ModelPickerResizeHandleProps extends Pick<
+  ComponentProps<"div">,
+  "onKeyDown" | "onDoubleClick"
+> {
+  /** "vertical" is the trailing-edge width handle, "horizontal" the free-edge height handle. */
+  orientation: "vertical" | "horizontal";
+  /** Horizontal handles only: which edge is opposite the popover's anchored side. */
+  side?: "top" | "bottom";
+  label: string;
+  value: number;
+  min: number;
+  max: number;
+  handlers: ModelPickerResizeHandlers;
+}
+
+export function ModelPickerResizeHandle({
+  orientation,
+  side,
+  label,
+  value,
+  min,
+  max,
+  handlers,
+  onKeyDown,
+  onDoubleClick,
+}: ModelPickerResizeHandleProps) {
+  const horizontal = orientation === "horizontal";
+  return (
+    <div
+      role="separator"
+      tabIndex={0}
+      aria-label={label}
+      aria-orientation={orientation}
+      aria-valuenow={Math.round(value)}
+      aria-valuemin={min}
+      aria-valuemax={max}
+      className={cn(
+        "group absolute z-20 touch-none select-none outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring",
+        horizontal
+          ? cn(
+              "inset-x-0 h-1.5 cursor-row-resize any-pointer-coarse:h-3",
+              side === "top" ? "top-0" : "bottom-0",
+            )
+          : "inset-y-0 right-0 w-1.5 cursor-col-resize any-pointer-coarse:w-3",
+      )}
+      onDoubleClick={onDoubleClick}
+      onKeyDown={onKeyDown}
+      {...handlers}
+    >
+      <span
+        aria-hidden
+        className={cn(
+          "pointer-events-none absolute rounded-full bg-transparent transition-colors duration-150 group-hover:bg-border group-focus-visible:bg-primary/60 group-active:bg-primary/60",
+          horizontal
+            ? cn("inset-x-6 h-0.5", side === "top" ? "top-0" : "bottom-0")
+            : "inset-y-6 right-0 w-0.5",
+        )}
+      />
+    </div>
+  );
+}
