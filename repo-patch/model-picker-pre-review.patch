diff --git a/apps/web/src/components/chat/useModelPickerResize.ts b/apps/web/src/components/chat/useModelPickerResize.ts
new file mode 100644
index 0000000..7c008f3
--- /dev/null
+++ b/apps/web/src/components/chat/useModelPickerResize.ts
@@ -0,0 +1,203 @@
+import * as Schema from "effect/Schema";
+import { type RefObject, useEffectEvent, useLayoutEffect, useState } from "react";
+
+import {
+  getLocalStorageItem,
+  removeLocalStorageItem,
+  setLocalStorageItem,
+} from "../../hooks/useLocalStorage";
+import { useResizeDrag } from "../../hooks/useResizeDrag";
+import { RESIZABLE_WIDTH_PROPERTY } from "../../hooks/useResizableWidth";
+
+const SizeSchema = Schema.Finite;
+
+export const RESIZABLE_HEIGHT_PROPERTY = "--resizable-height";
+
+const WIDTH_STORAGE_KEY = "t3code.modelPickerWidth";
+const HEIGHT_STORAGE_KEY = "t3code.modelPickerHeight";
+
+export const MODEL_PICKER_MIN_WIDTH = 288;
+export const MODEL_PICKER_MAX_WIDTH = 720;
+export const MODEL_PICKER_MIN_HEIGHT = 224;
+export const MODEL_PICKER_MAX_HEIGHT = 720;
+export const MODEL_PICKER_DEFAULT_WIDTH = 360;
+// h-86.5 == calc(var(--spacing) * 86.5) == 21.625rem.
+export const MODEL_PICKER_DEFAULT_HEIGHT = 346;
+
+function clamp(value: number, min: number, max: number): number {
+  if (!Number.isFinite(value)) return min;
+  return Math.max(min, Math.min(max, value));
+}
+
+function readStoredSize(key: string, min: number, max: number): number | null {
+  if (typeof window === "undefined") return null;
+  try {
+    const stored = getLocalStorageItem(key, SizeSchema);
+    return stored === null ? null : clamp(stored, min, max);
+  } catch (error) {
+    console.error("Could not read persisted model picker size.", error);
+    return null;
+  }
+}
+
+function readPopupSide(popup: Element | null): "top" | "bottom" {
+  return popup?.getAttribute("data-side") === "top" ? "top" : "bottom";
+}
+
+/**
+ * Persisted, drag-resizable width and height for the model picker popup.
+ * The popup sizes to content, so sizes land on its `[data-slot="popover-popup"]`
+ * ancestor; `width`/`height` stay null until the user resizes.
+ */
+export function useModelPickerResize(hostRef: RefObject<HTMLDivElement | null>) {
+  const [width, setWidth] = useState<number | null>(() =>
+    readStoredSize(WIDTH_STORAGE_KEY, MODEL_PICKER_MIN_WIDTH, MODEL_PICKER_MAX_WIDTH),
+  );
+  const [height, setHeight] = useState<number | null>(() =>
+    readStoredSize(HEIGHT_STORAGE_KEY, MODEL_PICKER_MIN_HEIGHT, MODEL_PICKER_MAX_HEIGHT),
+  );
+  const [popupSide, setPopupSide] = useState<"top" | "bottom">("bottom");
+
+  const popupOf = () =>
+    hostRef.current?.closest<HTMLElement>('[data-slot="popover-popup"]') ?? null;
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- applies persisted sizes and mirrors the popup's data-side; width/height only change on commit or reset, and re-applying is idempotent
+  useLayoutEffect(() => {
+    const popup = hostRef.current?.closest<HTMLElement>('[data-slot="popover-popup"]') ?? null;
+    if (!popup) return;
+    const apply = (axis: "x" | "y", value: number | null) => {
+      const property = axis === "x" ? RESIZABLE_WIDTH_PROPERTY : RESIZABLE_HEIGHT_PROPERTY;
+      const inline = axis === "x" ? "width" : "height";
+      if (value === null) {
+        popup.style.removeProperty(property);
+        popup.style.removeProperty(inline);
+        return;
+      }
+      popup.style.setProperty(property, `${value}px`);
+      popup.style.setProperty(inline, `${value}px`);
+    };
+    apply("x", width);
+    apply("y", height);
+    // Base UI flips the popup between side=top and side=bottom; the height handle has to follow.
+    const readSide = () => setPopupSide(readPopupSide(popup));
+    readSide();
+    const observer = new MutationObserver(readSide);
+    observer.observe(popup, { attributes: true, attributeFilter: ["data-side"] });
+    return () => observer.disconnect();
+  }, [hostRef, width, height]);
+
+  const commit = (axis: "x" | "y", value: number | null) => {
+    const property = axis === "x" ? RESIZABLE_WIDTH_PROPERTY : RESIZABLE_HEIGHT_PROPERTY;
+    const inline = axis === "x" ? "width" : "height";
+    const storageKey = axis === "x" ? WIDTH_STORAGE_KEY : HEIGHT_STORAGE_KEY;
+    const popup = popupOf();
+    if (value === null) {
+      popup?.style.removeProperty(property);
+      popup?.style.removeProperty(inline);
+      if (axis === "x") setWidth(null);
+      else setHeight(null);
+      try {
+        removeLocalStorageItem(storageKey);
+      } catch (error) {
+        console.error("Could not persist model picker size.", error);
+      }
+      return;
+    }
+    const clamped =
+      axis === "x"
+        ? clamp(value, MODEL_PICKER_MIN_WIDTH, MODEL_PICKER_MAX_WIDTH)
+        : clamp(value, MODEL_PICKER_MIN_HEIGHT, MODEL_PICKER_MAX_HEIGHT);
+    popup?.style.setProperty(property, `${clamped}px`);
+    popup?.style.setProperty(inline, `${clamped}px`);
+    if (axis === "x") setWidth(clamped);
+    else setHeight(clamped);
+    try {
+      setLocalStorageItem(storageKey, clamped, SizeSchema);
+    } catch (error) {
+      console.error("Could not persist model picker size.", error);
+    }
+  };
+  const commitAxis = useEffectEvent(commit);
+
+  const widthDrag = useResizeDrag<HTMLElement>(() => {
+    const host = hostRef.current;
+    const popup = popupOf();
+    if (!host) return null;
+    popup?.style.setProperty("transition-property", "none");
+    const startWidth = width ?? host.getBoundingClientRect().width;
+    return {
+      axis: "x",
+      width: startWidth,
+      edge: "right",
+      bounds: { min: MODEL_PICKER_MIN_WIDTH, max: MODEL_PICKER_MAX_WIDTH },
+      resize(nextWidth) {
